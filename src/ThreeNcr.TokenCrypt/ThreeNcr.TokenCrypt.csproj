<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ThreeNcr</RootNamespace>
    <AssemblyName>ThreeNcr.TokenCrypt</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>ThreeNcr.TokenCrypt</PackageId>
    <Version>1.0.0</Version>
    <Authors>3ncr.org</Authors>
    <Description>.NET implementation of the 3ncr.org v1 string encryption standard (AES-256-GCM).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://3ncr.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/3ncr/tokencrypt-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>3ncr;encryption;aes-gcm;argon2id;tokens</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
